      "apis": {
        "transfer_conversation": {
          "endpoint": "/conversation-transfer/transfer-conversation",
          "method": "POST",
          "parameters": {
            "conversationSid": "string (required)",
            "targetType": "enum ['worker', 'queue'] (required)",
            "targetSid": "string (required)",
            "transferReason": "string (optional)",
            "transferNotes": "string (optional)"
          },
          "response": {
            "success": "boolean",
            "inviteSid": "string"
          }
        }
      },
      "task_attributes": {
        "transferTargetType": "worker | queue",
        "transferTargetSid": "Worker SID for agent transfers",
        "transferQueueName": "Queue friendly name for queue transfers",
        "workerSidsInConversation": "array of current participant worker SIDs",
        "originalConversationSid": "source conversation identifier",
        "transferReason": "optional categorization",
        "transferNotes": "optional context for receiving agent"
      }
    },
