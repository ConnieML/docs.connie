  "technical_specifications": {
    "supported_channels": [
      "voice",
      "sms", 
      "webchat",
      "whatsapp"
    ],
    "transfer_types": {
      "cold_transfer": {
        "description": "Immediate transfer with agent disconnection",
        "use_cases": ["simple_handoffs", "queue_distribution"]
      },
      "warm_transfer": {
        "description": "Collaborative transfer with multi-participant support",
        "use_cases": ["complex_handoffs", "training_scenarios", "escalations"]
      }
    },
    "requirements": {
      "connieRTC_version": "2.8+",
      "taskrouter_workflow": "Chat Transfer workflow required",
      "permissions": [
        "conversations.transfer.send",
        "conversations.transfer.receive"
      ]
    }
  },
  "integration_points": {
    "taskrouter": {
      "workflow_sid": "TWILIO_FLEX_CHAT_TRANSFER_WORKFLOW_SID",
      "task_routing_logic": "Routes based on transferTargetType and transferTargetSid"
    },
    "interactions_api": {
      "invites_endpoint": "Creates transfer invitations",
      "participants_endpoint": "Manages conversation participants"
    },
    "frontend_hooks": [
      "actions_hook",
      "components_hook",
      "events_hook"
    ]
  },
  "configuration_examples": {
    "basic_feature_config": {
      "enabled": true,
      "cold_transfer": true,
      "multi_participant": true
    },
    "workflow_json": {
      "task_routing": {
        "filters": [
          {
            "expression": "transferTargetType == 'worker'",
            "targets": [
              {
                "queue": "everyone",
                "known_worker_sid": "{{task.transferTargetSid}}"
              }
            ]
          },
          {
            "expression": "transferTargetType == 'queue'",
            "targets": [
              {
                "queue": "{{task.transferQueueName}}"
              }
            ]
          }
        ]
      }
    }
  },
